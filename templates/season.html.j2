{% extends "base.html.j2" %}

{% block title %}Saison {{ season }} · La Canebière Académie{% endblock %}

{% block head %}
  <script src="https://cdn.jsdelivr.net/npm/vega@6.4.0"></script>
  <script src="https://cdn.jsdelivr.net/npm/vega-lite@6.4.1"></script>
  <script src="https://cdn.jsdelivr.net/npm/vega-embed@7.1.0"></script>
{% endblock %}

{% block style %}
    /* la série: un macaron par match */
    .serie { display: flex; flex-wrap: wrap; gap: 6px; }
    .serie a {
      display: grid; place-items: center;
      width: 30px; height: 30px; border-radius: 50%;
      font: 700 13px Oswald, sans-serif; color: white; text-decoration: none;
      transition: transform .12s;
    }
    .serie a:hover, .serie a:focus-visible { transform: scale(1.25); }
    .serie .Victoire { background: var(--bleu); }
    .serie .Nul { background: var(--sable); color: var(--marine); }
    .serie .Défaite { background: var(--rouge); }

    /* les records: et Mr Lapin */
    .records { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
    .record { position: relative; overflow: hidden; min-height: 240px; }
    .record h3 { margin: 0; font-size: 16px; color: var(--doux); }
    .record .score { font: 700 40px/1.1 Oswald, sans-serif; margin: 6px 0; }
    .record .score small { font-size: 18px; color: var(--doux); display: block; }
    .record.belle { border-left: 6px solid var(--bleu); }
    .record.pire { border-left: 6px solid var(--rouge); background: linear-gradient(180deg, white 50%, #FBEDEC 100%); }
    .record.pire .texte { max-width: 58%; }
    .lapin {
      position: absolute; right: 8px; bottom: 0;
      width: 40%; max-width: 190px;
      transform: translateY(62%);
      transition: transform .35s cubic-bezier(.3, 1.6, .5, 1);
      border-radius: 10px 10px 0 0;
      cursor: pointer;
    }
    .lapin img { width: 100%; display: block; border-radius: 10px 10px 0 0; box-shadow: 0 -2px 10px rgba(0, 0, 0, .25); }
    .lapin .indice { position: absolute; top: -26px; right: 0; font-size: 13px; color: var(--rouge); font-weight: 600; white-space: nowrap; }
    .record.pire:hover .lapin, .lapin:focus { transform: translateY(0); outline: none; }
    .record.pire:hover .lapin .indice, .lapin:focus .indice { visibility: hidden; }

    /* le palmarès */
    .podium { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
    .podium .carte h3 { margin: 0; font-size: 15px; color: var(--doux); }
    .podium .nom { font: 700 24px/1.2 Oswald, sans-serif; margin-top: 4px; }
    .podium .detail { color: var(--doux); font-size: 14px; }

    .graphe { width: 100%; }
    .vega-embed { width: 100%; }
    .vega-embed summary { display: none; }
    .deux { display: grid; grid-template-columns: 3fr 2fr; gap: 16px; }
    /* les deux cartes à la même hauteur: la distribution remplit la colonne */
    .deux > div, .deux .carte { display: flex; flex-direction: column; }
    .deux .carte { flex: 1; }
    .deux .graphe { flex: 1; min-height: 220px; }
    .deux .vega-embed { height: 100%; }
    @media (max-width: 760px) { .deux { grid-template-columns: 1fr; } }

    /* les mots de la saison */
    .compteurs { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
    .compteurs .tuile { margin: 0; }
    .compteurs .label { color: var(--texte); font-weight: 600; font-size: 15px; }
    .compteurs .detail { color: var(--doux); font-size: 13px; margin-top: 4px; }
    .compteurs .tuile.honte { border-color: var(--rouge); }
    .compteurs .tuile.slip { border-color: var(--or); }
    .compteurs .tuile.raie { border-color: var(--bleu); }
    .frissons { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px 4px; margin-top: 16px; }
    .frissons a { display: flex; flex-direction: column-reverse; align-items: center; width: 30px; text-decoration: none; font-size: 16px; line-height: 1.1; }
    .frissons .macaron { display: grid; place-items: center; width: 24px; height: 24px; margin-top: 4px; border-radius: 50%; font: 700 11px Oswald, sans-serif; color: white; }
    .frissons .Victoire { background: var(--bleu); } .frissons .Nul { background: var(--sable); color: var(--marine); } .frissons .Défaite { background: var(--rouge); }
    .frissons a:hover .macaron, .frissons a:focus-visible .macaron { transform: scale(1.2); }
    .surnoms { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin-top: 16px; }
    .surnoms .nom { font: 700 22px/1.2 Oswald, sans-serif; }
    .surnoms .detail { color: var(--doux); font-size: 14px; }
    .concours { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; margin-top: 16px; }
    .concours h3 { margin: 0 0 8px; font-size: 15px; color: var(--doux); }
    .concours ol { margin: 0; padding-left: 22px; }
    .concours li { padding: 2px 0; }
    .concours li span { float: right; color: var(--doux); font-variant-numeric: tabular-nums; }

    /* la liste des académies */
    table { width: 100%; border-collapse: collapse; font-size: 15px; }
    th { text-align: left; font-weight: 600; color: var(--doux); border-bottom: 2px solid var(--ligne); padding: 6px 8px; }
    td { border-bottom: 1px solid var(--ligne); padding: 6px 8px; vertical-align: top; }
    td.score { font-weight: 700; white-space: nowrap; }
    td .pastille { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; }
    .pastille.Victoire { background: var(--bleu); } .pastille.Nul { background: var(--sable); } .pastille.Défaite { background: var(--rouge); }
    .tableau { overflow-x: auto; }
    @media (max-width: 560px) { .cache-mobile { display: none; } }

{% endblock %}

{% block nav %}
      <a href="index.html">← Toutes les saisons</a>
      {% if precedente %}<a href="{{ precedente[1] }}.html">‹ {{ precedente[0] }}</a>{% endif %}
      {% if suivante %}<a href="{{ suivante[1] }}.html">{{ suivante[0] }} ›</a>{% endif %}
{% endblock %}

{% block hero %}
      <h1>Saison {{ season }}<span class="etoile">★</span></h1>
{% endblock %}

{% block content %}
    {% if not matchs %}
    <section><p class="carte">Pas encore d'académie cette saison. Blaah rumine.</p></section>
    {% else %}

    <div class="bilan">
      <div class="tuile"><div class="valeur">{{ bilan.matchs }}</div><div class="label">académies</div></div>
      <div class="tuile victoire"><div class="valeur">{{ bilan.victoires }}</div><div class="label">victoires</div></div>
      <div class="tuile nul"><div class="valeur">{{ bilan.nuls }}</div><div class="label">nuls</div></div>
      <div class="tuile defaite"><div class="valeur">{{ bilan.defaites }}</div><div class="label">défaites</div></div>
      <div class="tuile"><div class="valeur">{{ bilan.buts_pour }}<span style="color:var(--doux)">–</span>{{ bilan.buts_contre }}</div><div class="label">buts pour – contre</div></div>
    </div>

    <section>
      <h2>La série</h2>
      <p class="legende">Un macaron par match, dans l'ordre. Cliquer dessus pour lire l'académie.</p>
      <div class="carte serie">
        {% for m in matchs %}
        <a class="{{ m['Résultat'] }}" href="{{ m.url }}" target="_blank" rel="noopener" title="{{ m.Jour }} · {{ m.Match }} {{ m.Buts_R }}-{{ m.Buts_V }} · La Canebière Académie {{ m.Sous_titre }}">{{ m['Résultat'][0] }}</a>
        {% endfor %}
      </div>
    </section>

    {% if records.victoire or records.defaite %}
    <section>
      <h2>Les extrêmes</h2>
      <div class="records">
        {% if records.victoire %}{% set v = records.victoire %}
        <div class="carte record belle">
          <h3>La plus belle</h3>
          <div class="score">{{ v.Match }} {{ v.Buts_R }}-{{ v.Buts_V }}<small>{{ v.Jour }}</small></div>
          <a href="{{ v.url }}" target="_blank" rel="noopener">La Canebière Académie {{ v.Sous_titre }}</a>
        </div>
        {% endif %}
        {% if records.defaite %}{% set d = records.defaite %}
        <div class="carte record pire">
          <div class="texte">
            <h3>La pire</h3>
            <div class="score">{{ d.Match }} {{ d.Buts_R }}-{{ d.Buts_V }}<small>{{ d.Jour }}</small></div>
            <a href="{{ d.url }}" target="_blank" rel="noopener">La Canebière Académie {{ d.Sous_titre }}</a>
          </div>
          <div class="lapin" tabindex="0" aria-label="Mr Lapin a un message pour {{ d.Adversaire }}">
            <span class="indice">Mr Lapin a un message ↓</span>
            <img src="https://horsjeu.net/wp-content/uploads/2016/02/Mlapin.jpg" alt="Mr Lapin, une pancarte à la main">
          </div>
        </div>
        {% endif %}
      </div>
    </section>
    {% endif %}

    <section>
      <h2>Des matchs, des buts</h2>
      <p class="legende">Les buts de l'OM en bleu ciel, ceux de l'adversaire en rouge, match après match.</p>
      <div class="carte"><div class="graphe" id="scores"></div></div>
    </section>

    {% if podium %}
    <section>
      <h2>Le palmarès</h2>
      <p class="legende">Parmi les joueurs notés sur au moins un quart des matchs.</p>
      <div class="podium">
        <div class="carte"><h3>Le chouchou</h3><div class="nom">{{ podium.chouchou.Joueur }}</div><div class="detail">{{ podium.chouchou.Moyenne | note }}/5 de moyenne sur {{ podium.chouchou.Notes }} notes</div></div>
        <div class="carte"><h3>Le souffre-douleur</h3><div class="nom">{{ podium.souffre_douleur.Joueur }}</div><div class="detail">{{ podium.souffre_douleur.Moyenne | note }}/5 de moyenne sur {{ podium.souffre_douleur.Notes }} notes</div></div>
        <div class="carte"><h3>Le pilier</h3><div class="nom">{{ podium.pilier.Joueur }}</div><div class="detail">noté {{ podium.pilier.Notes }} fois</div></div>
        <div class="carte"><h3>Les 5/5</h3><div class="nom">{{ podium.cinq_sur_cinq }}</div><div class="detail">notes parfaites distribuées</div></div>
      </div>
    </section>

    <section>
      <h2>Le carnet de notes</h2>
      <p class="legende">Une ligne par joueur, une colonne par match. Rouge: la honte, bleu: la gloire.</p>
      <div class="carte"><div class="graphe" id="notes"></div></div>
    </section>

    <section class="deux">
      <div>
        <h2>Des notes, des moyennes</h2>
        <div class="carte"><div class="graphe" id="moyennes"></div></div>
      </div>
      <div>
        <h2>Toutes les notes</h2>
        <div class="carte"><div class="graphe" id="distribution"></div></div>
      </div>
    </section>
    {% endif %}

    {% if mots %}
    {% set gimmicks = {
      "honte": ("Greenwood (honte à nous)", "fois"),
      "slip": ("mentions du slipomètre", "mentions"),
      "raie": ("RAIE", "parades"),
    } %}
    <section>
      <h2>Les mots de la saison</h2>
      <p class="legende">Ce que Blaah répète, académie après académie.</p>
      {% if mots.compteurs %}
      <div class="compteurs">
        {% for nom, c in mots.compteurs.items() %}
        <div class="tuile {{ nom }}">
          <div class="valeur">{{ c.total }}</div>
          <div class="label">{{ gimmicks[nom][0] }}</div>
          <div class="detail">Record: {{ c.record }} {{ gimmicks[nom][1] if c.record > 1 else gimmicks[nom][1][:-1] }} dans <a href="{{ c.match.url }}" target="_blank" rel="noopener">{{ c.match.Match }} {{ c.match.Score }}</a></div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if mots.compteurs.slip or mots.compteurs.raie %}
      <div class="carte" style="margin-top: 16px">
        <h3 style="margin: 0; font-size: 16px; color: var(--doux)">Le slipomètre</h3>
        <p class="legende" style="margin: 2px 0 0; color: var(--doux)">🩲 une mention du slipomètre, 🧤 une RAIE, match après match.</p>
        <div class="frissons">
          {% for f in mots.frissons %}
          <a href="{{ f.url }}" target="_blank" rel="noopener" title="{{ f.Jour }} · {{ f.Match }} {{ f.Score }} · {{ f.slip }} slipomètre, {{ f.raie }} RAIE">
            <span class="macaron {{ f['Résultat'] }}">{{ f.Numero }}</span>
            {% for _ in range(f.raie) %}<span>🧤</span>{% endfor %}
            {% for _ in range(f.slip) %}<span>🩲</span>{% endfor %}
          </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if mots.surnoms %}
      <div class="surnoms">
        {% for s in mots.surnoms %}
        <div class="carte"><div class="nom">{{ s.Surnom }}</div><div class="detail">alias {{ s.Joueur }}, {{ s.Fois }} fois</div>{% if s.Note %}<div class="detail"><em>{{ s.Note }}</em></div>{% endif %}</div>
        {% endfor %}
      </div>
      {% endif %}

      {% if mots.concours %}
      <div class="concours">
        <div class="carte">
          <h3>Le concours zoologique, cette saison</h3>
          <ol>{% for l in mots.concours %}<li>{{ l.Lecteur }} <span>{{ l.Victoires }}</span></li>{% endfor %}</ol>
        </div>
        <div class="carte">
          <h3>Le concours zoologique, depuis toujours</h3>
          <ol>{% for l in mots.concours_toujours %}<li>{{ l.Lecteur }} <span>{{ l.Victoires }}</span></li>{% endfor %}</ol>
        </div>
      </div>
      {% endif %}
    </section>
    {% endif %}

    <section>
      <h2>Les académies</h2>
      <div class="carte tableau">
        <table>
          <thead><tr><th>Date</th><th>Match</th><th>Score</th><th class="cache-mobile">L'académie</th></tr></thead>
          <tbody>
          {% for m in matchs | reverse %}
            <tr>
              <td>{{ m.Jour }}</td>
              <td><span class="pastille {{ m['Résultat'] }}"></span>{{ m.Match }}</td>
              <td class="score">{{ m.Buts_R }}-{{ m.Buts_V }}</td>
              <td class="cache-mobile"><a href="{{ m.url }}" target="_blank" rel="noopener">{{ m.Sous_titre }}</a></td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}
{% endblock %}

{% block footer %}<br><a href="index.html">Retour aux statistiques</a>{% endblock %}

{% block scripts %}
  <script type="application/json" id="specs">{{ charts | safe }}</script>
  <script>
    const specs = JSON.parse(document.getElementById("specs").textContent);
    for (const [id, spec] of Object.entries(specs)) {
      const el = document.getElementById(id);
      if (el) vegaEmbed(el, spec, { actions: false, renderer: "svg", loader: { target: "_blank" } });
    }
  </script>
{% endblock %}
